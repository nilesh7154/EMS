# ===========================
# Backend .gitignore (Maven / Spring Boot)
# ===========================

# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
.mvn/wrapper/maven-wrapper.properties

# Environment / secrets
.env
*.env

# Logs
*.log
logs/

# IDE
.idea/
*.iml
.project
.classpath
.settings/

# Spring Boot DevTools restart trigger
.spring-boot-devtools.properties

# OS
.DS_Store
Thumbs.db
